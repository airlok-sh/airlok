{
    "name": "airlok/hosting-laravel",
    "type": "project",
    "description": "Laravel с PostgreSQL на хостинге airlok",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
