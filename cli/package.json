{
  "name": "@airlok/cli",
  "version": "0.3.2",
  "description": "Выкатка проекта на хостинг airlok из терминала и подключение ИИ-агентов: npx @airlok/cli setup",
  "type": "module",
  "bin": {
    "airlok": "bin/airlok.js"
  },
  "files": [
    "bin",
    "src",
    "skills"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test",
    "prepack": "node -e \"const fs=require('fs');fs.rmSync('skills',{recursive:true,force:true});fs.cpSync('../skills','skills',{recursive:true})\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airlok-sh/airlok.git",
    "directory": "cli"
  },
  "homepage": "https://airlok.ru",
  "keywords": [
    "deploy",
    "hosting",
    "airlok"
  ],
  "publishConfig": {
    "access": "public"
  }
}
